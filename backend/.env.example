# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/clanhaven

# Discord OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
