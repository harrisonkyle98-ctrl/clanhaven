generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = -1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform Users (Discord-authenticated) ───

model User {
  id        String   @id @default(cuid())
  discordId String   @unique @map("discord_id")
  username  String
  avatar    String?
  email     String?
  rsn         String?
  gameType    GameType? @map("game_type")
  accountType String?   @map("account_type")
  rsnClanName String?   @map("rsn_clan_name")
  rsnLinkedAt DateTime? @map("rsn_linked_at")
  privileges  Int       @default(0)
  lastOnline  DateTime? @map("last_online")
  isBanned      Boolean   @default(false) @map("is_banned")
  bannedAt      DateTime? @map("banned_at")
  bannedByUserId String?  @map("banned_by_user_id")
  banReason     String?   @map("ban_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activeRsn   String?   @map("active_rsn")

  memberships ClanMember[]
  ownedClans  Clan[]       @relation("ClanOwner")
  newsPosts   NewsPost[]
  loginHistory UserLoginHistory[]
  altRequests  AltAccountRequest[]

  @@map("users")
}

// ─── Clans (multi-tenant) ───

model Clan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  gameType    GameType @map("game_type")
  description String?
  iconUrl     String?  @map("icon_url")
  isPublic    Boolean  @default(true) @map("is_public")
  memberCount Int      @default(0) @map("member_count")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User         @relation("ClanOwner", fields: [ownerId], references: [id])
  members ClanMember[]

  @@index([slug])
  @@index([gameType])
  @@map("clans")
}

// ─── Clan Members (links users + RSN to a clan) ───

model ClanMember {
  id          String   @id @default(cuid())
  clanId      String   @map("clan_id")
  userId      String?  @map("user_id")
  rsn         String
  clanRank    String?  @map("clan_rank")
  clanRole    ClanRole @default(MEMBER) @map("clan_role")
  totalXp     BigInt   @default(0) @map("total_xp")
  totalLevel  Int      @default(0) @map("total_level")
  combatLevel Int      @default(0) @map("combat_level")
  stats       Json?
  active      Boolean  @default(true)
  joinedAt    DateTime? @map("joined_at")
  leftAt      DateTime? @map("left_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clan User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  clanRef Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, rsn])
  @@index([clanId, active])
  @@index([userId])
  @@map("clan_members")
}

// ─── Indexed Clans (from RS3 Clan Hiscores) ───

model IndexedClan {
  id          String   @id @default(cuid())
  name        String   @unique
  nameLower   String   @unique @map("name_lower")
  gameType    GameType @default(RS3) @map("game_type")
  memberCount Int      @default(0) @map("member_count")
  rank        Int?
  totalXp     BigInt   @default(0) @map("total_xp")
  source      String   @default("player_lookup")
  lastIndexedAt DateTime? @map("last_indexed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members IndexedClanMember[]

  @@index([rank])
  @@index([memberCount(sort: Desc)])
  @@index([totalXp(sort: Desc)])
  @@map("indexed_clans")
}

model IndexedClanMember {
  id        String   @id @default(cuid())
  clanId    String   @map("clan_id")
  rsn       String
  rsnLower  String   @map("rsn_lower")
  clanRank  String?  @map("clan_rank")
  clanXp    BigInt   @default(0) @map("clan_xp")
  kills     Int      @default(0)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clan IndexedClan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, rsnLower])
  @@index([rsnLower])
  @@map("indexed_clan_members")
}

// ─── News Posts ───

model NewsPost {
  id            String    @id @default(cuid())
  title         String
  content       String
  excerpt       String?
  category      String    @default("Update")
  bannerUrl     String?   @map("banner_url")
  thumbnailUrl  String?   @map("thumbnail_url")
  published     Boolean   @default(false)
  authorId      String?   @map("author_id")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt(sort: Desc)])
  @@map("news_posts")
}

// ─── Slider Images ───

model SliderImage {
  id            String   @id @default(cuid())
  slotNumber    Int      @unique @map("slot_number")
  imageUrl      String   @default("") @map("image_url")
  title         String   @default("")
  description   String   @default("")
  meta          String   @default("")
  cta           String   @default("")
  ctaLink       String   @default("") @map("cta_link")
  imageGradient String   @default("") @map("image_gradient")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active, slotNumber])
  @@map("slider_images")
}

// ─── Highlights ───

model Highlight {
  id            String   @id @default(cuid())
  slotNumber    Int      @unique @map("slot_number")
  imageUrl      String   @default("") @map("image_url")
  imagePosition String   @default("center") @map("image_position")
  title         String   @default("")
  description   String   @default("")
  buttonText    String   @default("") @map("button_text")
  buttonLink    String   @default("") @map("button_link")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active, slotNumber])
  @@map("highlights")
}

// ─── User Login History ───

model UserLoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String   @map("ip_address")
  userAgent String   @default("") @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([ipAddress])
  @@map("user_login_history")
}

// ─── IP Bans ───

model IpBan {
  id             String   @id @default(cuid())
  ipAddress      String   @map("ip_address")
  reason         String   @default("")
  active         Boolean  @default(true)
  createdByUserId String  @map("created_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ipAddress, active])
  @@map("ip_bans")
}

// ─── Alt Account Requests ───

model AltAccountRequest {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  rsn            String
  rsnLower       String   @map("rsn_lower")
  gameType       GameType @default(RS3) @map("game_type")
  accountType    String?  @map("account_type")
  clanName       String?  @map("clan_name")
  status         String   @default("pending")
  reviewedById   String?  @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewNote     String?  @map("review_note")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([rsnLower])
  @@index([status])
  @@map("alt_account_requests")
}

// ─── Seed Jobs (background clan discovery) ───

model SeedJob {
  id              String   @id @default(cuid())
  status          String   @default("pending")  // pending, running, completed, failed
  startPage       Int      @default(1) @map("start_page")
  pageCount       Int      @default(5) @map("page_count")
  pagesProcessed  Int      @default(0) @map("pages_processed")
  clansDiscovered Int      @default(0) @map("clans_discovered")
  clansIndexed    Int      @default(0) @map("clans_indexed")
  clansFailed     Int      @default(0) @map("clans_failed")
  currentPage     Int?     @map("current_page")
  currentClan     String?  @map("current_clan")
  lastError       String?  @map("last_error")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("seed_jobs")
}

// ─── Enums ───

enum GameType {
  RS3
  OSRS
}

enum ClanRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}
